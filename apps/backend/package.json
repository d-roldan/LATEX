{
    "name": "disal-mini-mes-backend",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "build": "nest build",
        "start": "node dist/src/main.js",
        "start:dev": "nest start --watch",
        "start:prod": "node dist/src/main.js",
        "lint": "eslint \"{src,prisma}/**/*.ts\"",
        "format": "prettier --write \"{src,prisma}/**/*.{ts,js,json,md}\"",
        "test": "jest",
        "prisma:generate": "prisma generate",
        "prisma:normalize-enums": "node prisma/run-with-root-env.cjs prisma db execute --file prisma/enum-rename.sql --schema prisma/schema.prisma",
        "prisma:migrate": "npm run prisma:normalize-enums && node prisma/run-with-root-env.cjs prisma db push --skip-generate",
        "prisma:deploy": "node prisma/run-with-root-env.cjs prisma migrate deploy",
        "prisma:install-empty": "node prisma/run-with-root-env.cjs node prisma/install-empty.cjs",
        "prisma:seed": "node prisma/run-with-root-env.cjs node dist/prisma/seed.js",
        "prisma:seed-disal-operational": "node prisma/run-with-root-env.cjs node dist/prisma/seed-disal-operational.js && node prisma/run-with-root-env.cjs node dist/prisma/seed-disal-stage-models.js",
        "prisma:seed-disal-stages": "node prisma/run-with-root-env.cjs node dist/prisma/seed-disal-stage-models.js",
        "prisma:remove-planning-stage": "node prisma/run-with-root-env.cjs prisma db execute --file prisma/remove-planning-stage.sql --schema prisma/schema.prisma",
        "prisma:add-usernames": "node prisma/run-with-root-env.cjs prisma db execute --file prisma/add-usernames.sql --schema prisma/schema.prisma",
        "prisma:backfill-quality-delivery-gates": "node prisma/run-with-root-env.cjs prisma db execute --file prisma/backfill-quality-delivery-gates.sql --schema prisma/schema.prisma",
        "security:ensure-system-owner": "node dist/prisma/system-owner.js",
        "security:rotate-system-owner-password": "node dist/prisma/system-owner.js --rotate"
    },
    "prisma": {
        "seed": "node dist/prisma/seed.js"
    },
    "dependencies": {
        "@nestjs/common": "^10.4.15",
        "@nestjs/config": "^3.2.3",
        "@nestjs/core": "^10.4.15",
        "@nestjs/jwt": "^10.2.0",
        "@nestjs/mapped-types": "^2.0.6",
        "@nestjs/passport": "^10.0.3",
        "@nestjs/platform-express": "^10.4.15",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/client": "^5.22.0",
        "bcrypt": "6.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "multer": "2.2.0",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "prisma": "^5.22.0",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.4.9",
        "@nestjs/schematics": "^10.2.3",
        "@nestjs/testing": "^10.4.15",
        "@types/bcrypt": "^5.0.2",
        "@types/express": "^4.17.21",
        "@types/jest": "^29.5.13",
        "@types/multer": "^2.1.0",
        "@types/node": "^20.17.19",
        "@types/passport-jwt": "^4.0.1",
        "@typescript-eslint/eslint-plugin": "^8.24.1",
        "@typescript-eslint/parser": "^8.24.1",
        "eslint": "^9.21.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.3",
        "jest": "^29.7.0",
        "prettier": "^3.5.2",
        "ts-jest": "^29.2.5",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.2"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    },
    "overrides": {
        "multer": "2.2.0",
        "lodash": "4.18.1",
        "body-parser": "1.20.6",
        "qs": "6.15.3",
        "express": {
            "path-to-regexp": "0.1.13"
        }
    }
}
