# Global
NODE_ENV=production
TZ=America/Buenos_Aires

# Database
POSTGRES_DB=planta_latex
POSTGRES_USER=planta_app
POSTGRES_PASSWORD=reemplazar_con_password_seguro
POSTGRES_PORT=5432
DATABASE_URL=postgresql://planta_app:reemplazar_con_password_seguro@disal-db:5432/planta_latex?schema=public

# Backend
BACKEND_PORT=3000
JWT_SECRET=reemplazar_con_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost,http://planta-latex.local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Protected system owner
SYSTEM_OWNER_COMPANY_ID=seed_company_disal
SYSTEM_OWNER_USERNAME=admin@planta.local
SYSTEM_OWNER_FULL_NAME=Administrador Planta de Látex
SYSTEM_OWNER_PASSWORD=reemplazar_con_password_de_administrador_seguro

# Integración Node-RED. Debe ser un secreto aleatorio largo y distinto del JWT.
NODE_RED_API_KEY=reemplazar_con_clave_node_red_segura
NODE_RED_PORT=1880
# Habilitar sólo para el simulador del Docker local; mantener false en producción.
DISAL_ENABLE_WEIGHT_SIMULATOR=false
DISAL_ENABLE_ENVASES_SIMULATOR=false
# Sólo Docker local. Clave distinta de ENVASES_NODE_RED_KEY de la integración real.
ENVASES_SIM_NODE_RED_KEY=
# Cada integración nueva usa una credencial hasheada y limitada a una planta.
# Variables del Node-RED externo (no exponer en VITE_*):
DISAL_API_BASE_URL=http://servidor-disal/api
DISAL_PLANT_CODE=LATEX
DISAL_INTEGRATION_KEY=reemplazar_con_clave_exclusiva_de_planta
DISAL_SOURCE_ID=NODE_RED_LATEX
DISAL_REQUEST_TIMEOUT_MS=5000

# Historial de peso en InfluxDB 2.x. Los nombres deben coincidir con la serie existente.
INFLUXDB_URL=
INFLUXDB_TOKEN=
INFLUXDB_ENVASES_TOKEN=
INFLUXDB_ORG=
INFLUXDB_ORG_ID=
INFLUXDB_ENVASES_BUCKET=
CMS_DB_HOST=
CMS_DB_PORT=3306
CMS_DB_USER=
CMS_DB_PASSWORD=
CMS_DB_NAME=disal_cms
# Cada planta tiene su propio perfil. {scaleKey} se reemplaza por la clave de la balanza.
INFLUXDB_LATEX_BUCKET=LATEX
INFLUXDB_LATEX_MEASUREMENT=PESOS_TANQUES_LATEX
INFLUXDB_LATEX_FIELD=PESO_{scaleKey}
INFLUXDB_LATEX_VIEJO_BUCKET=LATEX_BLANCO
INFLUXDB_LATEX_VIEJO_MEASUREMENT=TK{tankNumber}
INFLUXDB_LATEX_VIEJO_FIELD=value
INFLUXDB_TERPLAST_BUCKET=
INFLUXDB_TERPLAST_MEASUREMENT=
INFLUXDB_TERPLAST_FIELD=
INFLUXDB_SLURRY_BUCKET=
INFLUXDB_SLURRY_MEASUREMENT=
INFLUXDB_SLURRY_FIELD=
# Enduido no tiene sensores instalados actualmente.
INFLUXDB_ENDUIDO_BUCKET=
INFLUXDB_ENDUIDO_MEASUREMENT=
INFLUXDB_ENDUIDO_FIELD=
# Sintéticos identifica cada tanque por measurement, por ejemplo TK N° 01.
INFLUXDB_SINTETICOS_BUCKET=SINTETICO
INFLUXDB_SINTETICOS_MEASUREMENT=TK N° {tankNumberPadded}
INFLUXDB_SINTETICOS_FIELD=value
# Compatibilidad con instalaciones anteriores de Látex (opcionales).
INFLUXDB_BUCKET=
INFLUXDB_WEIGHT_MEASUREMENT=
INFLUXDB_TANK_TAG=
INFLUXDB_WEIGHT_FIELD=
INFLUXDB_QUERY_TIMEOUT_MS=8000

# Frontend
VITE_API_BASE_URL=/api

# Nginx
HTTP_PORT=80
HTTPS_PORT=443

# Resource safeguards (Docker Compose)
BACKEND_MEMORY_LIMIT=512m
BACKEND_CPU_LIMIT=1.0
DB_MEMORY_LIMIT=1g
DB_CPU_LIMIT=1.5
NGINX_MEMORY_LIMIT=128m
NGINX_CPU_LIMIT=0.5
NODE_RED_MEMORY_LIMIT=256m
NODE_RED_CPU_LIMIT=0.5
