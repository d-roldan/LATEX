    {
        "id": "build-weight-batch",
        "type": "function",
        "z": "disal-weight-simulator",
        "name": "Construir lote TK101-TK109",
        "func": "const tanks = [\n  [\"TK101\", 58970],\n  [\"TK102\", 38950],\n  [\"TK103\", 40130],\n  [\"TK104\", 25355],\n  [\"TK105\", 5425],\n  [\"TK106\", 8780],\n  [\"TK107\", 9545],\n  [\"TK108\", 8665],\n  [\"TK109\", 8085]\n];\n\nconst measuredAt = new Date().toISOString();\nconst phase = Date.now() / 12000;\n\nmsg.headers = {\n  \"content-type\": \"application/json\",\n  \"x-node-red-key\": env.get(\"NODE_RED_API_KEY\")\n};\nmsg.payload = {\n  readings: tanks.map(([scaleKey, base], index) => ({\n    scaleKey,\n    grossKg: Math.round(Math.max(0, base + Math.sin(phase + index) * (18 + index * 2))),\n    measuredAt\n  }))\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 1,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 450,
        "y": 170,
        "wires": [
            [
                "post-weights",
                "debug-request"
            ]
        ]
    },
