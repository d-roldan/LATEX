    {
        "id": "multiplant-check-response",
        "type": "function",
        "z": "disal-multiplant-live",
        "name": "Estado de envío",
        "func": "const plantCode = (msg.url.match(/plants\\/([^/]+)/) || [,'DESCONOCIDA'])[1];\nconst ok = msg.statusCode >= 200 && msg.statusCode < 300 && msg.payload && msg.payload.rejected === 0;\nnode.status({ fill: ok ? 'green' : 'red', shape: ok ? 'dot' : 'ring', text: plantCode + ' HTTP ' + (msg.statusCode || 'ERROR') });\nif (!ok) { node.warn({ plantCode, statusCode: msg.statusCode, response: msg.payload }); }\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
